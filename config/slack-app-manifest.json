{
  "display_information": {
    "name": "Dispatch",
    "description": "Coding agent that builds features from Slack requests",
    "background_color": "#1a1a2e"
  },
  "features": {
    "bot_user": {
      "display_name": "Dispatch",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "chat:write",
        "files:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR_APP_URL/api/slack/events",
      "bot_events": [
        "app_mention"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
